{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run QEMU GDB Server",
            "type": "shell",
            "command": "make qemu-gdb || sleep 1",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^\\*\\*\\*.*",
                        "endsPattern": "qemu-system-riscv64.*" 
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}